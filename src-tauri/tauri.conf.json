
{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Desktop Mascot for Muse",
  "version": "1.1.11",
  "identifier": "com.csofts.muse.gadgets",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Desktop Mascot for Muse",
        "label": "main",
        "width": 420,
        "height": 640,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "cSofts",
    "category": "Utility",
    "shortDescription": "Windows Desktop Mascot for Muse AI",
    "longDescription": "Windows desktop mascot and chat-integration app for Muse (a personal AI agent, https://muse.ai)",
    "copyright": "Copyright © 2026 cSofts.com. All rights reserved.",
    "resources": {
      "assets/avatars/setting.json": "avatars/setting.json",
      "assets/avatars/plugin/quotes.json": "avatars/plugin/quotes.json"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "languages": [
          "English"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/DashingMZA/desktop-mascot-for-muse/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhGRDUzNkQzQUUwQUVCMzQKUldRMDZ3cXUwemJWajBoaE4zSHBDb2x5dnhOMmw3ZEFpOFh3TTNBSWNrcFEzZXpOREoxRUVQbDAK"
    }
  }
}
